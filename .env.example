# LeadGurus API configuration.
# Copy this file to .env (gitignored) and fill in your actual values.
# The API is read-only; a single key spans every Vertex brand.

# Required: LeadGurus API key (sent as the X-API-Key header). Never commit the
# real value — in production this lives in Azure Key Vault and is injected as a
# Dagster+ environment variable.
TAP_LEADGURUS_API_KEY=your-api-key-here

# Required: earliest date to sync (YYYY-MM-DD). Floor for the date_after filter.
TAP_LEADGURUS_START_DATE=2026-01-01

# Optional: API base URL (defaults to production).
TAP_LEADGURUS_API_URL=https://clients.leadgurus.com/api/v1

# Optional: days to re-pull before the bookmark to catch late updates (default 7).
TAP_LEADGURUS_LOOKBACK_DAYS=7

# Optional: return spend with the LeadGurus management fee included (invoice
# basis) instead of ad spend only (default false). Every summary row carries
# fee_rate + spend_includes_fees so the basis received is always explicit.
TAP_LEADGURUS_INCLUDE_FEES=false
